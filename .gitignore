# =============================================================
# Boilerplate .gitignore for Python (FastAPI + uv) + Next.js apps
# =============================================================

# ---------- Secrets & environment ----------
# Never commit real secrets. Commit a .env.example instead.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
MANIFEST
# Python build output (anchored to backend so it can't hide frontend/src/lib etc.)
backend/build/
backend/dist/
backend/wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# uv / pip
.uv/
pip-log.txt
pip-delete-this-directory.txt

# Type checkers & linters
.mypy_cache/
.pyright/
.ruff_cache/
.pytype/
.dmypy.json
dmypy.json

# ---------- Python testing / coverage ----------
.pytest_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# Jupyter
.ipynb_checkpoints/

# ---------- Node / Next.js ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.eslintcache

# Next.js build output
.next/
out/
frontend/build/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Frontend testing
coverage/
/frontend/test-results/
/frontend/playwright-report/
/frontend/playwright/.cache/

# Vercel / Turbo
.vercel
.turbo

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Local databases ----------
*.db
*.sqlite
*.sqlite3
*.db-journal

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Editors & IDEs ----------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Claude Code local (per-user) settings
.claude/settings.local.json

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---------- Misc ----------
*.bak
*.tmp
*.temp
.cache/
